#!/bin/bash
# Lanca o RPCS3 na sessao grafica. Sem WAYLAND_DISPLAY exportado o Qt nao acha
# o compositor e abre em display "null" (mesma armadilha do PCSX2/RetroArch).
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export QT_QPA_PLATFORM=wayland
exec rpcs3 "$1" &> /tmp/rpcs3.log
